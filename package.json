    "prosemirror-markdown": "^1.13.1",
    "prosemirror-model": "^1.25.0",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.4.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.34.0"
  },
  "devDependencies": {
